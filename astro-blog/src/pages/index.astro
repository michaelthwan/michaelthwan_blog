---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { placeOf } from '../data/topics';
import { writtenDate, fmt } from '../data/postDates';

// Dynamic duration for current role (started Nov 2024)
const startDate = new Date(2024, 10); // month is 0-indexed
const now = new Date();
const totalMonths = (now.getFullYear() - startDate.getFullYear()) * 12 + (now.getMonth() - startDate.getMonth());
const yrs = Math.floor(totalMonths / 12);
const mos = totalMonths % 12;
const masterDuration = [yrs && `${yrs} yr${yrs > 1 ? 's' : ''}`, mos && `${mos} mo${mos > 1 ? 's' : ''}`].filter(Boolean).join(' ');

// Employers, newest first; roles inside an employer are newest first too
const employers = [
    {
        name: 'Mastercard', place: 'Vancouver, BC', span: `Nov 2024 – Present · ${masterDuration}`,
        logo: '/img/front-page/mastercard_logo.jpg',
        roles: [
            {
                role: 'Lead Data Scientist', dates: 'Nov 2024 – Present',
                achievements: [
                    'Engineered <strong>Decision Intelligence Pro (DI Pro)</strong> fraud detection platform for credit and debit transactions. Optimized the Databricks ML pipeline and infrastructure, accelerating model training by 3x while significantly reducing operational costs.',
                ],
            },
        ],
    },
    {
        name: 'OOCL', place: 'Hong Kong', span: 'Jun 2014 – Sep 2023 · 9 yrs 3 mos',
        logo: '/img/front-page/oocl_logo.jpg',
        roles: [
            {
                role: 'Senior Data Scientist', dates: 'Aug 2021 – Sep 2023',
                achievements: [
                    'Led <strong>Customer Service Automation</strong> — LLM + RAG with LangChain, cutting email reply time from 5–10 min to seconds.',
                    'Built <strong>EDI AI Developer</strong> for GenAI-driven API migration across 20k+ customers — 82% accuracy, 8,000+ human-days saved.',
                    'Developed <strong>Shipment Assignment Optimization</strong> via CPLEX — <strong>$200M annual profit increase</strong> on Trans-Pacific and Asia-Europe routes.',
                    'Built <strong>Customer Demand &amp; Profit Forecast</strong> with hierarchical ML (LightGBM / PyTorch).',
                    'Led 3 concurrent projects with a team of 12 data scientists.',
                ],
            },
            {
                role: 'Data Scientist', dates: 'Sep 2018 – Aug 2021',
                achievements: [
                    'Collaborated with <strong>Microsoft Research Asia</strong> on empty repositioning — replaced linear programming with reinforcement and supervised learning.',
                    'Built <strong>Network Optimization Engine</strong> using genetic algorithms for container disruption recovery, improving accuracy from 75% to 87%.',
                ],
            },
            {
                role: 'Software Engineer (ML)', dates: 'Apr 2017 – Sep 2018',
                achievements: [
                    'Built <strong>Empty Repositioning Optimization</strong> engine with linear programming — <strong>reduced $36M in annual equipment costs</strong> (4% of $900M).',
                ],
            },
            {
                role: 'Software Engineer (Full-stack)', dates: 'Jun 2014 – Apr 2017',
                achievements: [
                    'Built core ERP components and customer-facing systems on J2EE/Oracle and MEAN stacks, supporting billion-scale shipping operations.',
                    'Delivered route cost calculator and sailing schedule search engine processing 30M+ routes.',
                ],
            },
        ],
    },
];

const education = [
    {
        school: 'The Chinese University of Hong Kong', logo: '/img/front-page/cuhk_logo.jpg', dates: '2020 – 2022',
        degree: 'Master of Science — Data Science and Business Statistics',
    },
    {
        school: 'The Chinese University of Hong Kong', logo: '/img/front-page/cuhk_logo.jpg', dates: '2011 – 2014',
        degree: 'Bachelor of Engineering — System Engineering & Engineering Management, Information Technology',
    },
];

// Writing: newest three posts by writing date
const posts = (await getCollection('posts'))
    .map(post => {
        const w = writtenDate(post);
        return {
            post,
            root: placeOf(post.slug, post.data.category).root,
            time: w.valid ? w.date.getTime() : 0,
            date: !w.valid ? w.raw : fmt(w.date, w.hasDay ? { month: 'short', day: 'numeric', year: 'numeric' } : { month: 'short', year: 'numeric' }),
        };
    })
    .sort((a, b) => b.time - a.time);
const latest = posts.slice(0, 3);
---

<Base title="Michael Wan" isHomepage={true}>
    <Header logoText="Michael Wan" />

    <main class="hp l-page">
        <!-- Hero -->
        <section class="hp-hero">
            <div class="hp-hero-text">
                <h1>Michael Wan</h1>
                <p class="hp-kicker">Lead Data Scientist · Mastercard · Vancouver</p>
                <p class="hp-lede">
                    I build AI systems that optimize enterprise operations, from LLM-powered automation
                    to large-scale optimization engines. I also write interactive explainers on AI and
                    deep learning.
                </p>
                <div class="hp-links">
                    <a href="/blog" class="hp-btn hp-btn-primary">Read the blog <span aria-hidden="true">&rarr;</span></a>
                    <a href="https://github.com/michaelthwan" target="_blank" rel="noopener noreferrer" class="hp-btn" aria-label="GitHub">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                        </svg>
                        GitHub
                    </a>
                    <a href="https://www.linkedin.com/in/michaelthwan" target="_blank" rel="noopener noreferrer" class="hp-btn" aria-label="LinkedIn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        LinkedIn
                    </a>
                </div>
            </div>
            <img src="/img/mw-black.png" alt="MW logo" class="hp-logo" width="168" height="168" />
        </section>

        <!-- Writing -->
        <section class="hp-section">
            <div class="hp-section-head">
                <h2>Writing</h2>
                <div class="hp-section-links">
                    <a href="/tree">By topic</a>
                    <a href="/blog">By date</a>
                </div>
            </div>
            <ol class="hp-latest">
                {latest.map(item => (
                    <li style={`--c: ${item.root.color}`}>
                        <a href={`/posts/${item.post.slug}`}>
                            <span class="hp-latest-meta"><i aria-hidden="true"></i>{item.root.short} · {item.date}</span>
                            <span class="hp-latest-title">{item.post.data.title}</span>
                            <span class="hp-latest-sub">{item.post.data.subtitle}</span>
                        </a>
                    </li>
                ))}
            </ol>
        </section>

        <!-- Experience -->
        <section class="hp-section">
            <div class="hp-section-head"><h2>Experience</h2></div>
            {employers.map(emp => (
                <div class="hp-employer">
                    <div class="hp-employer-head">
                        <img src={emp.logo} alt="" class="hp-badge" />
                        <div>
                            <h3>{emp.name}</h3>
                            <p class="hp-meta">{emp.place} · {emp.span}</p>
                        </div>
                    </div>
                    <ol class:list={['hp-roles', { 'hp-roles-ladder': emp.roles.length > 1 }]}>
                        {emp.roles.map(r => (
                            <li class="hp-role">
                                <div class="hp-role-head">
                                    <h4>{r.role}</h4>
                                    <span class="hp-dates">{r.dates}</span>
                                </div>
                                <ul class="hp-achievements">
                                    {r.achievements.map(a => <li set:html={a} />)}
                                </ul>
                            </li>
                        ))}
                    </ol>
                </div>
            ))}
        </section>

        <!-- Education -->
        <section class="hp-section">
            <div class="hp-section-head"><h2>Education</h2></div>
            {education.map(e => (
                <div class="hp-edu">
                    <img src={e.logo} alt="" class="hp-badge" />
                    <div class="hp-edu-text">
                        <h4>{e.degree}</h4>
                        <p class="hp-meta">{e.school}</p>
                    </div>
                    <span class="hp-dates">{e.dates}</span>
                </div>
            ))}
        </section>
    </main>

    <Footer />
</Base>

<style>
    .hp {
        max-width: 1040px;
        padding-top: 56px;
        padding-bottom: 72px;
    }

    /* Hero */
    .hp-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 48px;
        align-items: center;
    }
    .hp-kicker {
        margin: 0 0 20px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-gray);
    }
    .hp-hero h1 {
        font-family: var(--font-display);
        font-size: 52px;
        line-height: 1.05;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 10px;
        color: var(--color-text);
    }
    .hp-lede {
        max-width: 620px;
        margin: 0 0 26px;
        font-size: 18px;
        line-height: 1.6;
        color: var(--color-text);
    }
    .hp-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .hp-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        font-size: 14px;
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
        transition: border-color 0.12s, background-color 0.12s;
    }
    .hp-btn:hover {
        border-color: var(--color-text);
        text-decoration: none;
    }
    .hp-btn-primary {
        background: var(--color-text);
        border-color: var(--color-text);
        color: var(--color-bg);
    }
    .hp-btn-primary:hover { color: var(--color-bg); opacity: 0.88; }
    .hp-logo {
        width: 168px;
        height: 168px;
        border-radius: 28px;
        display: block;
    }

    /* Sections */
    .hp-section { margin-top: 56px; }
    .hp-section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 12px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--color-border);
    }
    .hp-section-head h2 {
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 600;
        margin: 0;
        padding: 0;
        border: none;
        color: var(--color-text);
    }
    .hp-section-links {
        display: flex;
        gap: 18px;
        font-size: 14px;
        font-weight: 500;
    }
    .hp-section-links a { color: var(--color-gray); text-decoration: none; }
    .hp-section-links a:hover { color: var(--color-text); }

    /* Writing: latest three posts */
    .hp-latest {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .hp-latest li + li a { border-top: 1px solid var(--color-border); }
    .hp-latest a {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 16px 0;
        color: inherit;
        text-decoration: none;
    }
    .hp-latest-meta {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-gray);
    }
    .hp-latest-meta i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--c);
    }
    .hp-latest-title {
        font-family: var(--font-display);
        font-size: 19px;
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-text);
        transition: color 0.12s;
    }
    .hp-latest a:hover .hp-latest-title { color: var(--c); }
    .hp-latest-sub {
        font-size: 14.5px;
        line-height: 1.5;
        color: var(--color-gray);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Experience */
    .hp-employer {
        padding: 22px 0 6px;
    }
    .hp-employer + .hp-employer { border-top: 1px solid var(--color-border); }
    .hp-employer-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
    }
    .hp-badge {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        border: 1px solid var(--color-border);
        background: #fff;
        object-fit: contain;
        flex: none;
    }
    .hp-employer-head h3 {
        font-family: var(--font-display);
        font-size: 19px;
        font-weight: 600;
        margin: 0;
        color: var(--color-text);
    }
    .hp-meta {
        margin: 2px 0 0;
        font-size: 13.5px;
        color: var(--color-gray);
    }
    .hp-roles {
        list-style: none;
        margin: 0 0 0 54px;
        padding: 0;
    }
    /* Several roles at one employer: a thin rail with a dot per role, newest on top */
    .hp-roles-ladder { border-left: 1px solid var(--color-border); margin-left: 19px; padding-left: 34px; }
    .hp-role {
        position: relative;
        padding-bottom: 18px;
    }
    .hp-roles-ladder .hp-role::before {
        content: '';
        position: absolute;
        left: -39px;
        top: 7px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--color-bg);
        border: 2px solid var(--color-gray-light);
    }
    .hp-roles-ladder .hp-role:first-child::before {
        background: var(--color-text);
        border-color: var(--color-text);
    }
    .hp-role-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }
    .hp-role-head h4,
    .hp-edu h4 {
        font-size: 16px;
        font-weight: 600;
        margin: 0;
        color: var(--color-text);
    }
    .hp-dates {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--color-gray);
        white-space: nowrap;
    }
    .hp-achievements {
        margin: 0;
        padding-left: 18px;
        font-size: 14.5px;
        line-height: 1.6;
        color: var(--color-gray);
    }
    .hp-achievements li { margin: 3px 0; }
    .hp-achievements li::marker { color: var(--color-gray-light); }
    .hp-achievements :global(strong) { color: var(--color-text); font-weight: 600; }

    /* Education */
    .hp-edu {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 16px 0;
    }
    .hp-edu + .hp-edu { border-top: 1px solid var(--color-border); }

    @media (max-width: 760px) {
        .hp { padding-top: 32px; }
        .hp-hero { grid-template-columns: 1fr; gap: 24px; }
        .hp-logo { order: -1; width: 88px; height: 88px; border-radius: 18px; }
        .hp-hero h1 { font-size: 38px; }
        .hp-lede { font-size: 16.5px; }
        .hp-roles { margin-left: 0; }
        .hp-roles-ladder { margin-left: 4px; padding-left: 22px; }
        .hp-roles-ladder .hp-role::before { left: -28px; }
        .hp-edu { grid-template-columns: 40px minmax(0, 1fr); }
        .hp-edu .hp-dates { grid-column: 2; }
    }
</style>
