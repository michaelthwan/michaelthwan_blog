---
import type { CollectionEntry } from 'astro:content';

interface Props {
    post: CollectionEntry<'posts'>;
    formatDate: (dateStr: string) => string;
    featured?: boolean;
    categoryLabel?: string;
}

const { post, formatDate, featured = false, categoryLabel } = Astro.props;
const primaryTag = post.data.tags?.[0];
---

<article class:list={['post-preview', { 'post-featured': featured }]}>
    <a href={`/posts/${post.slug}`} class="post-link">
        <div class="post-thumbnail">
            {post.data.thumbnail ? (
                <img src={post.data.thumbnail} alt="" />
            ) : (
                <div class="thumbnail-fallback" aria-hidden="true">
                    <span>Article</span>
                </div>
            )}
        </div>
        <div class="post-content">
            <div class="post-meta">
                {featured && <span class="post-kicker">Latest{categoryLabel && ` · ${categoryLabel}`}</span>}
                <span class="post-date">{formatDate(post.data.published)}</span>
                {!featured && primaryTag && <span class="post-tag-label">{primaryTag}</span>}
            </div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-abstract">{post.data.abstract}</p>
            <!-- No byline on the card. It used to print post.data.authors, which on the six
                 paper-explainer posts is the original paper's authors - so a card read as
                 though Devlin or Brin had written this blog. Printing the site owner instead
                 just repeats one name down the whole page. On a single-author blog the byline
                 carries no information either way; the article page keeps it under "Authors",
                 where for an explainer it correctly names the paper's authors. -->
        </div>
    </a>
</article>
